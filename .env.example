# Backend only. Never commit real secrets.
PORT=8080
APP_ENV=development
API_PUBLIC_BASE_URL=http://localhost:8080
AUTH_TOKEN_HASH=
# Optional bootstrap workspace pin. Normal authenticated sync uses persisted workspace membership.
SYNC_WORKSPACE_ID=
# Account session lifetime in seconds (default 7 days).
SESSION_TTL_SECONDS=604800
WHATSAPP_PROVIDER_URL=
WHATSAPP_ACCESS_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=
REPORT_PROVIDER_URL=
REPORT_PROVIDER_TOKEN=
AI_PROVIDER_URL=
AI_API_KEY=

# AI providers for BACKEND_MANAGED mode. Keep real values only in deployment environment.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CLOUD_SYNC_ENABLED=false
REMOTE_BACKUP_ENABLED=false

# Web build-time public API base URL (not a secret)
VITE_API_BASE_URL=http://localhost:8080
